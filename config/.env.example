# Copy this file to config/.env and adjust as needed.
# Every value has a sensible default; override here for your environment.
# Real environment variables always take precedence over this file.

# --- Data source ---
# Public UCI Online Shoppers Purchasing Intention Dataset (CC BY 4.0).
DATASET_URL=https://archive.ics.uci.edu/static/public/468/online+shoppers+purchasing+intention+dataset.zip

# --- Paths (default to repo-relative locations; override only if needed) ---
# DATA_DIR=data
# RAW_DATA_DIR=data/raw
# PARQUET_PATH=data/parquet/sessions.parquet
# SAMPLE_SESSIONS_PATH=data/sample_sessions.json
# MODELS_DIR=models

# --- Reproducibility ---
# Single seed used for the train/test split and the model.
RANDOM_STATE=42

# --- Scoring and next-best-action thresholds ---
INTENT_HIGH_THRESHOLD=0.6
INTENT_MEDIUM_THRESHOLD=0.3
DISENGAGE_RATE_THRESHOLD=0.05

# --- Serving (FastAPI) ---
# Comma-separated origins allowed by CORS. Includes Vite's fallback ports (5174/5175)
# in case 5173 is already taken and Vite shifts the dev server up.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000

# --- Narrative explanations (optional) ---
# Any hosted model endpoint that speaks the common chat-completions HTTP API.
# Leave unset to run the demo without narratives; the UI hides the card.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT_SECONDS=20

# --- Frontend ---
# Base URL the React app calls. The app reads this from the environment at build
# time and must never hardcode it.
API_BASE_URL=http://localhost:8000
